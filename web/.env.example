# Copy to .env.local for local development.

# --- Database (docker compose "db" service) ---
DATABASE_URL=postgres://bday:bday@localhost:5440/bday
# Connections one server process may hold (default 10). On Vercel set 3 and use Supabase's transaction pooler URL.
# DATABASE_POOL_MAX=3

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console "HTML tag" verification code (the content="…" value). Empty locally.
GOOGLE_SITE_VERIFICATION=

# --- Fake clock (development only) ---
# Makes the app believe it is this moment (ISO 8601). Leave empty for the real time.
# Examples: 2026-10-07T23:58:00-04:00 (2 min before Oct 7 ends, ET)
#           2028-02-29T10:00:00-05:00 (a real Feb 29)
DEV_NOW=

# --- Email ---
# "smtp" sends to Mailpit locally (inbox: http://localhost:8030), "resend" in production.
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1030
RESEND_API_KEY=
EMAIL_FROM="mybday.lol <hello@mybday.lol>"
# Where "Questions? Just reply" goes (the client's support inbox).
EMAIL_REPLY_TO=mybdaylol@gmail.com
# Postal address in the email footer (needed for reminders).
EMAIL_FOOTER_ADDRESS=
ADMIN_ALERT_EMAIL=admin@example.com

# --- Stripe (test mode keys while developing) ---
STRIPE_SECRET_KEY=
# From `stripe listen --print-secret` locally, or the Dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=
# Not needed for hosted Checkout (server redirect); kept for any future embedded Stripe UI.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Photo storage ---
# "local" saves to ./public/uploads, "supabase" uploads to a public Supabase Storage bucket (production).
STORAGE_DRIVER=local
# Only for STORAGE_DRIVER=supabase. The service-role key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=photos

# --- Live boards ---
# Open pages follow the board without a reload: the Stripe webhook announces a change through Supabase
# Realtime and each page re-reads. Both values are public (they ship to the browser): the project URL and
# its publishable key (the older "anon" key works too). Never the service-role key.
# Empty = no push; pages still check by themselves every 15 seconds. Run `pnpm db:init` once on the
# Supabase database so visitors may listen to the channel (and only the server may send).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Admin ---
# bcrypt/scrypt hash of the admin password (a helper script comes with the admin build step).
ADMIN_PASSWORD_HASH=
# Random string, used to sign admin sessions and unsubscribe links.
APP_SECRET=change-me-to-a-long-random-string

# --- Cron ---
# Vercel sends this as a Bearer token to /api/cron/* (emails every minute, see vercel.json).
# Locally there is no cron: run `pnpm emails:tick` to send what's due.
CRON_SECRET=
